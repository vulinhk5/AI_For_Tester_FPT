    {
      "name": "LOGIN API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "// 1. HTTP Status Code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Response Time",
              "pm.test(\"Response time is below 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// 3. Content-Type",
              "pm.test(\"Content-Type includes application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "// 4. Response Body",
              "pm.test(\"Body is valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Body is an object (not null, not array)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\").and.not.equal(null);",
              "    pm.expect(Array.isArray(jsonData)).to.be.false;",
              "});",
              "",
              "pm.test(\"Body has exactly 2 keys: token and refreshToken\", function () {",
              "    var jsonData = pm.response.json();",
              "    var keys = Object.keys(jsonData);",
              "    pm.expect(keys).to.have.lengthOf(2);",
              "    pm.expect(keys).to.include(\"token\");",
              "    pm.expect(keys).to.include(\"refreshToken\");",
              "});",
              "",
              "// 5. Required Fields",
              "pm.test(\"token exists and is not empty\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"token\");",
              "    pm.expect(jsonData.token).to.not.be.empty;",
              "});",
              "",
              "pm.test(\"refreshToken exists and is not empty\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"refreshToken\");",
              "    pm.expect(jsonData.refreshToken).to.not.be.empty;",
              "});",
              "",
              "// 6. Data Type Validation",
              "pm.test(\"token is a string\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"refreshToken is a string\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.refreshToken).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"token matches JWT format (3 segments separated by dots)\", function () {",
              "    var jsonData = pm.response.json();",
              "    var jwtRegex = /^[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+$/;",
              "    pm.expect(jwtRegex.test(jsonData.token)).to.be.true;",
              "});",
              "",
              "pm.test(\"refreshToken matches JWT format (3 segments separated by dots)\", function () {",
              "    var jsonData = pm.response.json();",
              "    var jwtRegex = /^[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+$/;",
              "    pm.expect(jwtRegex.test(jsonData.refreshToken)).to.be.true;",
              "});",
              "",
              "// 7. JSON Schema Validation (tv4)",
              "pm.test(\"Response matches JSON schema (tv4)\", function () {",
              "    var jsonData = pm.response.json();",
              "    var schema = {",
              "        \"type\": \"object\",",
              "        \"required\": [\"token\", \"refreshToken\"],",
              "        \"properties\": {",
              "            \"token\": { \"type\": \"string\", \"minLength\": 1 },",
              "            \"refreshToken\": { \"type\": \"string\", \"minLength\": 1 }",
              "        },",
              "        \"additionalProperties\": false",
              "    };",
              "    pm.expect(tv4.validate(jsonData, schema)).to.be.true;",
              "});",
              "",
              "// Bonus: Save token to environment",
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"authToken\", jsonData.token);",
              "pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "",
              "",
              "// ============================================================",
              "// NEGATIVE TESTS",
              "// ============================================================",
              "",
              "const LOGIN_URL = \"https://eu.thingsboard.cloud/api/auth/login\";",
              "",
              "// === CATEGORY A: Required Field Missing ===",
              "",
              "pm.test(\"Missing username field returns 401\", function (done) {",
              "    pm.sendRequest({",
              "        url: LOGIN_URL,",
              "        method: \"POST\",",
              "        header: { \"Content-Type\": \"application/json\" },",
              "        body: { mode: \"raw\", raw: JSON.stringify({ \"password\": \"abc123456\" }) }",
              "    }, function (err, res) {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res).to.have.status(401);",
              "        done();",
