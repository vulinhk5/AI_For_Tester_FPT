              "        body: {",
              "            mode: \"raw\",",
              "            raw: JSON.stringify({ \"username\": null, \"password\": \"abc123456\" })",
              "        }",
              "    }, function (err, res) {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res).to.have.status(401);",
              "        done();",
              "    });",
