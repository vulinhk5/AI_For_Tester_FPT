              "        url: LOGIN_URL,",
              "        method: \"POST\",",
              "        header: { \"Content-Type\": \"application/json\" },",
              "        body: { mode: \"raw\", raw: JSON.stringify({ \"username\": \"tiendungtoandrew@gmail.com\" }) }",
              "    }, function (err, res) {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res).to.have.status(401);",
              "        done();",
              "    });",
              "});",
              "",
              "pm.test(\"Both fields missing returns 400 or 401\", function (done) {",
